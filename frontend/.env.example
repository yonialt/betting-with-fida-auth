# ---------------------------------------------------------------------------
# Frontend (Vite) environment.
#
# All backend integration (auth, wallet, bets, matches, AI oracle, Redis,
# API-Football) now lives in the Spring Boot service. The secrets that used to
# sit here — GEMINI_API_KEY, API_FOOTBALL_KEY, ODDS_API_KEY, REDIS_URL — belong
# to the backend now (see backend-springboot/README and application.yml) and
# must never be shipped to the browser.
# ---------------------------------------------------------------------------

# Where the Vite dev/preview proxy forwards /api and /ws (default shown):
VITE_BACKEND_ORIGIN=http://localhost:8080

# Alternatively, bypass the proxy and call the backend directly from the browser.
# This requires the backend CORS allow-list (app.cors.allowed-origins) to include
# the frontend origin.
# VITE_API_BASE_URL=http://localhost:8080/api
# VITE_WS_BASE_URL=ws://localhost:8080/ws
